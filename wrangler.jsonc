{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gta-recycling",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "env": {
    "staging": {
      "name": "gta-recycling-staging"
    }
  }
}

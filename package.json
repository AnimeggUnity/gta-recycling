{
  "name": "gta-recycling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "publish:local": "npm run build && sudo rsync -a --delete dist/ /var/www/gta-recycling/",
    "deploy:staging": "npm run build && wrangler deploy --env staging"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^24.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.102.0"
  }
}
